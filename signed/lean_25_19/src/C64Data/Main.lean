/-- Every arc of the list passes the checker. -/
def AllOK (g : Glob) : List Arc → Prop
  | [] => True
  | a :: as => checkArc g a = true ∧ AllOK g as

theorem AllOK.mem {g : Glob} : ∀ {l : List Arc}, AllOK g l → ∀ a ∈ l, checkArc g a = true
  | [], _, a, ha => by simp at ha
  | b :: l, h, a, ha => by
    simp only [List.mem_cons] at ha
    rcases ha with rfl | ha
    · exact h.1
    · exact AllOK.mem h.2 a ha

theorem AllOK.append {g : Glob} : ∀ {l₁ l₂ : List Arc}, AllOK g l₁ → AllOK g l₂ → AllOK g (l₁ ++ l₂)
  | [], _, _, h₂ => h₂
